MONGO_URI=mongodb://localhost:27017
DB_NAME=ai_code_reviewer
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
GEMINI_API_KEY=your_actual_gemini_key
FRONTEND_URL=http://localhost:5173

# Email for forgot-password codes. EMAIL_PROVIDER: log | brevo | smtp (empty = disabled)
#   local dev      -> EMAIL_PROVIDER=log   (codes are printed to the server log)
#   Render (free)  -> EMAIL_PROVIDER=brevo (HTTPS API; Render free blocks SMTP ports)
#   AWS            -> EMAIL_PROVIDER=smtp with Amazon SES SMTP credentials
EMAIL_PROVIDER=log
EMAIL_FROM=KrishnaLens <you@example.com>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
